generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model gateway {
  gateway_id   String           @id @db.VarChar(64)
  name         String?
  group_id     String?
  group        device_group?    @relation(fields: [group_id], references: [group_id])
  status       gateway_status?
  devices      gateway_device[]
  gateway_info gateway_info?
}

model gateway_info {
  gateway_id    String @id
  api_key       String
  tenant_domain String
  region        String
  app_id        String

  gateway gateway @relation(fields: [gateway_id], references: [gateway_id])
}

model gateway_status {
  gateway_id String    @id
  status     Status
  last_seen  DateTime? @db.DateTime(3)

  gateway gateway @relation(fields: [gateway_id], references: [gateway_id])
}

model device {
  device_id   String           @id @db.VarChar(64)
  name        String?
  group_id    String? // device → group
  group       device_group?    @relation(fields: [group_id], references: [group_id])
  status      device_status?
  gateways    gateway_device[]
  device_info device_info? // 1:1
}

model device_info {
  device_id     String  @id
  mqtt_username String
  mqtt_password String
  mqtt_topic    String
  mqtt_broker   String
  mqtt_port     Int
  api_endpoint  String?
  fields        Json?
  device        device  @relation(fields: [device_id], references: [device_id])
}

model device_status {
  device_id String    @id
  status    Status
  last_seen DateTime? @default(now()) @db.DateTime(3) // ← เพิ่ม

  device device @relation(fields: [device_id], references: [device_id])
}

model gateway_device {
  gateway_id String
  device_id  String

  gateway gateway @relation(fields: [gateway_id], references: [gateway_id])
  device  device  @relation(fields: [device_id], references: [device_id])

  @@id([gateway_id, device_id])
}

model device_group {
  group_id String    @id @db.VarChar(64)
  name     String
  devices  device[] // ← 1 group มีหลาย device
  gateways gateway[] // ← 1 group มีหลาย gateway
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}

enum Status {
  ONLINE
  OFFLINE
  UNKNOWN
}
